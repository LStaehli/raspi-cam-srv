# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit it.

# ── Network ──────────────────────────────────────────────────────────────────
CAM_HOST=0.0.0.0
CAM_PORT=8080
# Combined bind address used by the systemd/gunicorn service (HOST:PORT).
# Must be kept in sync with CAM_HOST and CAM_PORT above.
CAM_BIND=0.0.0.0:8080

# ── TLS / HTTPS ───────────────────────────────────────────────────────────────
# Set to true to enable HTTPS (requires cert/key files below).
CAM_TLS=false
CAM_TLS_CERT=certs/server.crt
CAM_TLS_KEY=certs/server.key

# ── Authentication ────────────────────────────────────────────────────────────
# If CAM_PASSWORD is empty a random one-time password is printed at startup.
CAM_USERNAME=admin
CAM_PASSWORD=change_me_please

# ── Camera ────────────────────────────────────────────────────────────────────
# Set CAM_MOCK=true on machines without a physical camera (dev/CI).
CAM_MOCK=false

CAM_WIDTH=1280
CAM_HEIGHT=720
CAM_FPS=15

# ── Streaming ─────────────────────────────────────────────────────────────────
# Default format shown in the web UI: mjpeg | snapshot | hls
CAM_FORMAT=mjpeg

# JPEG quality for MJPEG stream (1–95).
CAM_MJPEG_QUALITY=75

# HLS: directory for .m3u8 playlist and .ts segments.
CAM_HLS_DIR=/tmp/cam_hls
CAM_HLS_SEGMENT=2

# ── Rate limiting ─────────────────────────────────────────────────────────────
CAM_RATELIMIT=60 per minute
CAM_RATELIMIT_STREAM=5 per minute
